# ============================================================
# ARGOS — .gitignore
# Keep source code, configs, docs and small metadata in Git.
# Keep raw/derived data, local secrets, caches and model artifacts out.
# ============================================================

# ---------- Operating systems ----------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
__MACOSX/
Thumbs.db
Desktop.ini

# ---------- Python bytecode / caches ----------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
.hypothesis/
.cache/

# ---------- Python environments ----------
.venv/
venv/
env/
ENV/
.conda/
conda-meta/

# ---------- Packaging / build ----------
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# ---------- Jupyter / IPython ----------
.ipynb_checkpoints/
.ipython/
.jupyter/
*.nbconvert.ipynb

# ---------- Test / coverage ----------
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# ---------- Local environment / secrets ----------
.env
.env.*
!.env.example
*.secret
*.secrets
secrets/
credentials/
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
service-account*.json
credentials*.json

# ---------- Data: Bronze / Silver / Gold ----------
# Data is intentionally NOT versioned with Git.
# Keep only the directory placeholders.
data/bronze/*
!data/bronze/.gitkeep

data/silver/*
!data/silver/.gitkeep

data/gold/*
!data/gold/.gitkeep

data/external/*
!data/external/.gitkeep

data/samples/*
!data/samples/.gitkeep

# Defensive data-file patterns anywhere else in the repo.
*.csv
*.csv.gz
*.tsv
*.tsv.gz
*.parquet
*.parq
*.feather
*.arrow
*.orc
*.avro
*.sas7bdat
*.sav
*.dta
*.xlsx
*.xls
*.h5
*.hdf5
*.npz
*.npy

# ---------- Local databases ----------
*.duckdb
*.duckdb.wal
*.db
*.sqlite
*.sqlite3

# ---------- Generated reports ----------
# Markdown documentation is intentionally trackable.
reports/**/*.csv
reports/**/*.tsv
reports/**/*.parquet
reports/**/*.feather
reports/**/*.arrow
reports/**/*.jsonl
reports/**/*.html
reports/**/*.png
reports/**/*.jpg
reports/**/*.jpeg
reports/**/*.svg
reports/**/*.pdf

# Keep report directory placeholders.
!reports/profiling/.gitkeep
!reports/quality/.gitkeep
!reports/figures/.gitkeep
!reports/experiments/.gitkeep

# ---------- ML / experiment artifacts ----------
artifacts/*
!artifacts/models/
artifacts/models/*
!artifacts/models/.gitkeep

models/
checkpoints/
mlruns/
mlartifacts/
wandb/
lightning_logs/
ray_results/
catboost_info/
*.pkl
*.pickle
*.joblib
*.onnx
*.pt
*.pth
*.ckpt
*.bin
*.safetensors

# ---------- Logs / temporary files ----------
logs/
*.log
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo
*~

# ---------- IDEs / editors ----------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.vscode/settings.local.json
.history/

# ---------- Node / frontend (future dashboard) ----------
node_modules/
.next/
out/
coverage/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- ML/data tooling caches ----------
.dvc/cache/
.dvc/tmp/
.prefect/
.great_expectations/uncommitted/

# ---------- Cloud / IaC local state ----------
.azure/
.aws/
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ---------- Local containers ----------
.docker/
docker-data/
volumes/

# ---------- Misc generated files ----------
*.bak
*.orig
*.rej
